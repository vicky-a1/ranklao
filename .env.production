# Production Environment Variables
# Copy this file to .env.production and update with your production values

# Supabase Configuration
VITE_SUPABASE_PROJECT_ID=your_production_project_id
VITE_SUPABASE_ANON_KEY=your_production_anon_key
VITE_SUPABASE_URL=https://your_production_project_id.supabase.co

# Payment Configuration
VITE_RAZORPAY_KEY_ID=your_production_razorpay_key_id
RAZORPAY_KEY_SECRET=your_production_razorpay_secret

# OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret

# Application Configuration
VITE_APP_ENV=production
VITE_APP_URL=https://your-production-domain.com
VITE_API_URL=https://your-production-api.com

# Security
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true